# Atlas secrets — copy to .env and fill in values
# NEVER commit .env to git

ATLAS_DB_PASSWORD=

# REST API keys (comma-separated). Clients authenticate with:
#   Authorization: Bearer <one-of-these-keys>
# Leave empty to keep the API fully locked (all protected routes return 401).
ATLAS_API_KEYS=

# Read-only email (S20d). Set host/username in config (plugins.mail.*); put the
# password here. Leave empty to keep the `mail` capability reporting "unavailable".
ATLAS_MAIL_PASSWORD=

# =============================================================================
# Outbound SMTP (Gmail) — ops Notifier + investor morning/trade reports
# Use a Google App Password (not your normal Gmail password).
# =============================================================================
# ATLAS_EMAIL_HOST=smtp.gmail.com
# ATLAS_EMAIL_PORT=587
# ATLAS_EMAIL_USERNAME=you@gmail.com
# ATLAS_EMAIL_FROM_ADDR=you@gmail.com
# ATLAS_SMTP_PASSWORD=your-16-char-app-password
# Receivers (comma-separated) for morning plan + every buy/sell decision email:
# ATLAS_INVESTOR_REPORT_TO=you@gmail.com,partner@example.com
# (alias) ATLAS_EMAIL_TO_ADDRS=you@gmail.com,partner@example.com

# Optional: also put the same keys in your real .env (never commit secrets).

# Stage 3.2 resource caps + OCR bounds (optional; defaults in config/defaults.yaml).
# Host-first: prefer conservative on shared desktops; stability > throughput.
# ATLAS_RESOURCES_PROFILE=conservative
# ATLAS_RESOURCES_MAX_WORKER_THREADS=3
# ATLAS_RESOURCES_MAX_CONCURRENT_TICKS=2   # global Persistent Worker tick slots
# ATLAS_RESOURCES_MAX_ARCHIVE_WORKERS=1   # parallel Owner Knowledge ingest; keep 1 during market hours; set 2 only to opt in 2nd archive slot
# ATLAS_RESOURCES_HOST_RAM_RESERVE_MB=3072  # keep free for OS/desktop on 16GB hosts
# ATLAS_RESOURCES_TICK_RAM_MB=512
# ATLAS_RESOURCES_RAM_USED_HIGH=0.80
# ATLAS_RESOURCES_LOAD_PRESSURE_HIGH=0.85
# ATLAS_RESOURCES_MAX_DOWNLOAD_WORKERS=2
# ATLAS_RESOURCES_MAX_READER_WORKERS=2
# ATLAS_RESOURCES_MAX_OCR_WORKERS=1
# ATLAS_RESOURCES_MAX_EXTRACT_WORKERS=1
# ATLAS_RESOURCES_OCR_MAX_PAGES=50
# ATLAS_RESOURCES_OCR_MAX_MINUTES=15
# ATLAS_RESOURCES_OCR_DPI=300
# IR-RO10: opt-in BATCH quiet hours (default off — daytime BATCH still runs)
# ATLAS_RESOURCES_ENFORCE_BATCH_WINDOW=false
# ATLAS_RESOURCES_BATCH_QUIET_START_HOUR=22
# ATLAS_RESOURCES_BATCH_QUIET_END_HOUR=6
# Nested Stage 3.2d costs/budgets use full paths:
# ATLAS_RESOURCES_COSTS_LLM_EXTRACT_UNITS=15
# ATLAS_RESOURCES_COSTS_LLM_EXTRACT_RAM_MB=2100
# ATLAS_RESOURCES_BUDGETS_BALANCED=20
# LLM extract parallelism is also capped by ATLAS_LLM_MAX_CONCURRENCY (default 1).
# All LLM-heavy work shares the Resource Manager's global LLM lane.
# Stage 3.2e: async JobPlanner (create returns immediately; planner timeout separate):
# ATLAS_JOBS_PLANNER_TIMEOUT=60
# ATLAS_JOBS_PLANNER_NUM_PREDICT=512
# Profiles: conservative | balanced | maximum | overnight
# Overnight may prefer +1/+2 workers only inside MAX_WORKER_THREADS; never fails if busy.
# Host-respect: under pressure Atlas defers ticks and queues archive starts — jobs are not dropped.
# See docs/RESOURCE_OS.md and docs/ATLAS_IMPLEMENTATION_ROADMAP.md
